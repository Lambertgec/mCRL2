% This is a modified version of the First Orchard game, where the player has
% an additional action available when rolling the basket action. Given that the 
% player has collected enough pieces of fruit, they can choose to exchange 
% a set number in exchange for moving the raven back by 1 step.

% The goal of this specification is to model the game in a way where the optimal
% strategy is no longer trivial.

sort 
    Fruit = struct rApple | gApple | pear | plum;
    DiceVal = struct fruit(Fruit) | raven | basket;

act 
    dice_roll: DiceVal;
    pick: Fruit;
    victory, defeat;
    return_fruits: Fruit # Fruit # Fruit;

map init_orchard: Fruit -> Nat;
    total: (Fruit -> Nat) -> Nat;
    dec: Nat -> Nat;
    inc_fruit: Nat -> Nat;
    inc_raven: Nat -> Nat;
    return1: (Fruit -> Nat) # Fruit -> (Fruit -> Nat);
    return3: (Fruit -> Nat) # Fruit # Fruit # Fruit -> (Fruit -> Nat);
    costReduce, ravenCount, fruitCount: Nat;

var f, f1, f2, f3: Fruit,
    orch: Fruit -> Nat,
    n: Nat;
eqn init_orchard(f) = fruitCount;
    total(orch) = orch(rApple) + orch(gApple) + orch(pear) + orch(plum);
    dec(n) = if(n>0, Int2Nat(n-1), 0);
    inc_fruit(n) = if(n < fruitCount, Int2Nat(n+1), fruitCount);
    inc_raven(n) = if(n < ravenCount, Int2Nat(n+1), ravenCount);
    return1(orch, f1) = orch[f1 -> inc_fruit(orch(f1))];
    return3(orch, f1, f2, f3) = return1(return1(return1(orch, f1), f2), f3);
    costReduce = 3;
    ravenCount = 5;
    fruitCount = 4;

proc BasketAction(orch: Fruit -> Nat, ravenTimer: Nat) =
    ( ((fruitCount * 4) >= (total(orch) + costReduce)) && (ravenTimer < ravenCount) ) ->
    (
        ( sum f1: Fruit . (orch(f1) >= 1) -> pick(f1) . Game(orch[f1 -> dec(orch(f1))], ravenTimer) )
        +
        reduce_raven(orch, ravenTimer)
    )
    <>
    ( sum f1: Fruit . (orch(f1) >= 1) -> pick(f1) . Game(orch[f1 -> dec(orch(f1))], ravenTimer) );

proc reduce_raven(orch: Fruit -> Nat, ravenTimer: Nat) =
    sum f1, f2, f3: Fruit . 
    (
        (total(return3(orch, f1, f2, f3)) == (total(orch) + costReduce)) -> 
            return_fruits(f1, f2, f3) . Game(return3(orch, f1, f2, f3), inc_raven(ravenTimer))
    );

proc Game(orch: Fruit -> Nat, ravenTimer: Nat) =
    (total(orch) == 0) -> victory . delta
    <> (ravenTimer == 0) -> defeat . delta
    <> (ravenTimer > 0 && total(orch) > 0) ->
        dist d:DiceVal[1/6] . (
            sum f: Fruit . (d == fruit(f)) -> (dice_roll(fruit(f)) . Game(orch[f -> dec(orch(f))], ravenTimer))
            <> (d == raven)   -> (dice_roll(raven) . Game(orch, dec(ravenTimer)))
            <> (d == basket)  -> (dice_roll(basket) . BasketAction(orch, ravenTimer))
        );

init Game(init_orchard, ravenCount);