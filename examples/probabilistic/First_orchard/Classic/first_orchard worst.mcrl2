% An implementation of the First Orchard game, where the nondeterministic
% player choice under the basket action is replaced with the least optimal 
% strategy of always picking the fruit with the lowest count. 

sort 
    Fruit = struct rApple | gApple | pear | plum;
    DiceVal = struct fruit(Fruit) | raven | basket;

act 
    dice_roll: DiceVal;
    pick: Fruit;
    victory, defeat;

map init_orchard: Fruit -> Nat;
    empty_orch: Fruit -> Nat;
    total: (Fruit -> Nat) -> Nat;
    dec: Nat -> Nat;
    worse: Fruit # Fruit # (Fruit -> Nat) -> Fruit;
    worst_fruit: (Fruit -> Nat) -> Fruit;
var f: Fruit,
    f1, f2: Fruit,
    orch: Fruit -> Nat,
    n: Nat;
eqn init_orchard(f) = 4;
    empty_orch(f) = 0;
    total(orch) = orch(rApple) + orch(gApple) + orch(pear) + orch(plum);
    dec(n) = if(n>0, Int2Nat(n-1), 0);
    worse(f1, f2, orch) = if(orch(f1) == 0,
                             f2,
                             if(orch(f2) == 0,
                                f1,
                                if(orch(f1) <= orch(f2), f1, f2)));
    worst_fruit(orch) = 
        worse(rApple, worse(gApple, worse(pear, plum, orch), orch), orch);

proc Basket(orch: Fruit -> Nat, ravenTimer: Nat) =
    (total(orch) <= 1) -> Game(empty_orch, ravenTimer)
    <>
    (total(orch) > 1) -> 
        sum f1: Fruit . (
            (f1 == worst_fruit(orch)) -> 
                pick(f1) . Game(orch[f1 -> dec(orch(f1))], ravenTimer)
        );

proc Game(orch: Fruit -> Nat, ravenTimer: Nat) =
    (total(orch) == 0) -> victory . delta
    <> (ravenTimer == 0) -> defeat . delta
    <> (ravenTimer > 0 && total(orch) > 0) ->
        dist d:DiceVal[1/6] . (
            sum f: Fruit . (d==fruit(f)) -> (dice_roll(fruit(f)) . Game(orch[f -> dec(orch(f))], ravenTimer))
            <> (d==raven)   -> (dice_roll(raven) . Game(orch, dec(ravenTimer)))
            <> (d==basket)  -> (dice_roll(basket) . Basket(orch, ravenTimer))
        );

init Game(init_orchard, 5);