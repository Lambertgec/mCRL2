% This mCRL2 specification models the game First Orchard. This is a cooperative game, where player(s) roll a die, and 
% try to exhaust a set of fruits in the orchard before a raven arrives. The orchard contains 4 types of fruit,
% namely red apples, green apples, pears and plums, each of which has 4 pieces. The raven arrives after taking 5 steps.
% The die has 6 sides, 4 of which corresponds to taking a piece of a specific fruit, 1 to progressing the raven by one step, 
% and lastly, a basket face allows the player to pick a piece of fruit arbitrarily.
% The game is won if the orchard is emptied before the raven arrives, and lost otherwise. 

sort 
    Fruit = struct rApple | gApple | pear | plum;
    DiceVal = struct fruit(Fruit) | raven | basket;

act 
    dice_roll: DiceVal;
    pick: Fruit;
    victory, defeat;

map init_orchard: Fruit -> Nat;
    total: (Fruit -> Nat) -> Nat;
    dec: Nat -> Nat;
var f: Fruit,
    orch: Fruit -> Nat,
    n: Nat;
eqn init_orchard(f) = 4;
    total(orch) = orch(rApple) + orch(gApple) + orch(pear) + orch(plum);
    dec(n) = if(n>0, Int2Nat(n-1), 0);

proc Basket(orch: Fruit -> Nat, ravenTimer: Nat) =
    sum f1: Fruit . (
        (orch(f1) > 0) -> pick(f1) . Game(orch[f1 -> dec(orch(f1))], ravenTimer)
    );

proc Game(orch: Fruit -> Nat, ravenTimer: Nat) =
    (total(orch) == 0) -> victory . delta
    <> (ravenTimer == 0) -> defeat . delta
    <> (ravenTimer > 0 && total(orch) > 0) ->
        dist d:DiceVal[1/6] . (
            sum f: Fruit . (d==fruit(f)) -> (dice_roll(fruit(f)) . Game(orch[f -> dec(orch(f))], ravenTimer))
            <> (d==raven)  -> (dice_roll(raven) . Game(orch, dec(ravenTimer)))
            <> (d==basket) -> (dice_roll(basket) . Basket(orch, ravenTimer))
        );

init Game(init_orchard, 5);